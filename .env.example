# ============================================================
# E-Commerce Platform — Spring Boot Backend Environment Variables
# ============================================================
# Copy this file to .env in the backend directory (or set environment variables).
# NEVER commit real passwords or database credentials to Git.
# ============================================================

# Server Port (default: 8080)
SERVER_PORT=8080

# Active Spring Profile (dev / prod)
SPRING_PROFILES_ACTIVE=dev

# Supabase PostgreSQL Database JDBC Connection URL
# Format: jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# Supabase PostgreSQL Username (default: postgres)
DATABASE_USERNAME=postgres.your-project-ref

# Supabase PostgreSQL Password
DATABASE_PASSWORD=your-supabase-db-password-here

# Supabase Auth JWT Issuer URI
# Format: https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER_URI=https://your-project-ref.supabase.co/auth/v1

# Supabase Auth JWKS Public Key Endpoint
# Format: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URI=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Allowed CORS Origins (comma-separated list for production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Hibernate DDL Auto Mode (dev: update, prod: validate)
SPRING_JPA_HIBERNATE_DDL_AUTO=update
